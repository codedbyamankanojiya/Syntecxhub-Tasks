<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme: edge-to-edge dark, no action bar (Compose handles UI) -->
    <style name="Theme.DeshNews" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0E17</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.DeshNews</item>
    </style>
</resources>
