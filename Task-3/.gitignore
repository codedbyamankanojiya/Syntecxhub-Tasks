# ====================================================================
# Task-3: DeshNews 24/7 — Android Project .gitignore
# ====================================================================

# ── Confidential, Secrets & Sensitive API Keys ───────────────────────
local.properties
app/local.properties
*/local.properties
**/local.properties

.env
.env.*
*.env
secrets.properties
app/secrets.properties
*/secrets.properties
**/secrets.properties
private.properties
**/private.properties
secure.properties
**/secure.properties
keystore.properties
**/keystore.properties
signing.properties
**/signing.properties
release.properties
**/release.properties

# API keys, tokens & service accounts
google-services.json
**/google-services.json
credentials.json
**/credentials.json
service-account*.json
**/service-account*.json
client_secrets.json
**/client_secrets.json
auth_tokens.json
**/auth_tokens.json
jwt.json
**/jwt.json
*.key
*.token
*.credentials

# Signing keystores & credentials (NEVER commit these)
*.jks
*.keystore
*.p12
*.pem
*.cer
*.crt

# ── Gradle & Android Build Outputs ───────────────────────────────────
build/
app/build/
*/build/
.gradle/
app/.gradle/
*/.gradle/

# AGP intermediate directories
app/src/main/generated/
.cxx/
.externalNativeBuild/
bin/
gen/
out/

# KSP (Kotlin Symbol Processing) outputs
**/build/generated/ksp/

# Room Database Schema exports
app/schemas/
**/schemas/

# ── Compiled & Packaged Artifacts ────────────────────────────────────
*.apk
*.aab
*.aar
*.ap_
*.dex
*.class

# ── Android Studio / IntelliJ IDEA ───────────────────────────────────
.idea/
app/.idea/
*/.idea/
*.iml
*.iws
*.ipr
captures/
.navigation/

# ── VS Code & Other Editors ───────────────────────────────────────────
.vscode/
*.swp
*.swo
*~
*.bak

# ── OS & System Generated Files ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Logs & Crash Dumps ────────────────────────────────────────────────
*.log
hs_err_pid*
replay_pid*

# ── Kotlin & Gradle Caches ────────────────────────────────────────────
.kotlin/
kotlin-js-store/

# Gradle wrapper verification files
gradle/wrapper/gradle-wrapper.jar
