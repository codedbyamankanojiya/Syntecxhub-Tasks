## local.properties.example — Template for local environment configuration
#
# Copy this file to `local.properties` in this directory:
#   cp local.properties.example local.properties
#
# 1. Android SDK path (automatically configured by Android Studio)
# sdk.dir=/path/to/your/android/sdk
#
# 2. GNews API Key (obtain a free key at https://gnews.io)
GNEWS_API_KEY=YOUR_GNEWS_API_KEY_HERE
